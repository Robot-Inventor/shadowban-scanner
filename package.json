{
  "name": "shadowban-scanner",
  "version": "4.1.1",
  "description": "A browser extension that detects shadowbans on X (formerly Twitter).",
  "keywords": [
    "extension",
    "react",
    "shadowban",
    "twitter"
  ],
  "homepage": "https://github.com/Robot-Inventor/shadowban-scanner#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/shadowban-scanner/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/shadowban-scanner.git"
  },
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint ./src ./script ./rspack.config.ts && knip && node ./script/addonsLinter.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "cross-env NODE_ENV=production npx rspack build",
    "dev": "cross-env NODE_ENV=development npx rspack build --watch",
    "ci:build": "cross-env NODE_ENV=production npx rspack build --env updateUserScripts",
    "package": "node ./script/package.ts",
    "version": "npm run package && git add .",
    "prepare": "ts-patch install && typia patch"
  },
  "dependencies": {
    "@material/web": "^2.0.0",
    "addons-linter": "^10.0.0",
    "chokidar": "^6.0.0",
    "colors": "^1.4.0",
    "css-loader": "^7.0.0",
    "glob": "^14.0.0",
    "lit": "^3.0.2",
    "style-loader": "^4.0.0",
    "twi-ext": "^1.0.0",
    "typescript": "^6.0.0",
    "web-ext": "^10.0.0",
    "webextension-polyfill": "^0.12.0",
    "webpack-license-plugin": "^4.4.2"
  },
  "devDependencies": {
    "@robot-inventor/oxlint-config": "^1.0.0",
    "@robot-inventor/ts-utils": "^0.8.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "@types/addons-linter": "^6.16.0",
    "@types/node": "^26.6.1",
    "@types/webextension-polyfill": "^0.12.0",
    "@typia/unplugin": "^12.0.1",
    "cross-env": "^10.0.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "knip": "^6.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.83.0",
    "ts-patch": "^4.0.0",
    "typia": "^12.0.1"
  }
}
