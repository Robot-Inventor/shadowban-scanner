  },
  "devDependencies": {
    "@robot-inventor/oxlint-config": "^0.3.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0",
    "@rspack/dev-server": "^2.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.0.0",
    "css-loader": "^7.1.2",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "oxlint": "^1.83.0",
